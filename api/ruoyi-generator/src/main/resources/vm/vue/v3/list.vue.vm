<template>
  <div class="app-container">
    <el-form @submit.prevent :model="${businessName}QueryParams" ref="${businessName}QueryRef" :inline="true" v-show="${businessName}ShowSearch" label-width="auto">
      <el-form-item label="创建时间">
        <el-date-picker
          style="width: 230px;"
          v-model="dateRange"
          value-format="YYYY-MM-DD"
          type="daterange"
          range-separator="-"
          start-placeholder="开始日期"
          end-placeholder="结束日期"
        ></el-date-picker>
      </el-form-item>
#foreach($column in $columns)
#if($column.query && $column.javaField.substring(0,3).toUpperCase() != "EXT")
#set($dictType=$column.dictType)
#set($AttrName=$column.javaField.substring(0,1).toUpperCase() + ${column.javaField.substring(1)})
#set($parentheseIndex=$column.columnComment.indexOf("（"))
#if($parentheseIndex != -1)
#set($comment=$column.columnComment.substring(0, $parentheseIndex))
#else
#set($comment=$column.columnComment)
#end
#if($column.htmlType == "input")
      <el-form-item label="${comment}" prop="${column.javaField}Like">
        <el-input
          v-model="${businessName}QueryParams.${column.javaField}Like"
          placeholder="请输入${comment}"
          clearable
          @keyup.enter="${businessName}HandleQuery"
        />
      </el-form-item>
#elseif(($column.htmlType == "select" || $column.htmlType == "radio") && "" != $dictType)
      <el-form-item label="${comment}" prop="${column.javaField}">
        <el-select v-model="${businessName}QueryParams.${column.javaField}" placeholder="请选择${comment}" clearable>
          <el-option
            v-for="dict in ${dictType}"
            :key="dict.value"
            :label="dict.label"
            :value="dict.value"
          />
        </el-select>
      </el-form-item>
#elseif(($column.htmlType == "select" || $column.htmlType == "radio") && $dictType)
      <el-form-item label="${comment}" prop="${column.javaField}">
        <el-select v-model="${businessName}QueryParams.${column.javaField}" placeholder="请选择${comment}" clearable>
          <el-option label="请选择字典生成" value="" />
        </el-select>
      </el-form-item>
#elseif($column.htmlType == "datetime" && $column.queryType != "BETWEEN")
      <el-form-item label="${comment}" prop="${column.javaField}">
        <el-date-picker
          clearable
          v-model="${businessName}QueryParams.${column.javaField}"
          type="date"
          value-format="YYYY-MM-DD"
          placeholder="请选择${comment}"
        />
      </el-form-item>
#elseif($column.htmlType == "datetime" && $column.queryType == "BETWEEN")
      <el-form-item label="${comment}" style="width: 308px">
        <el-date-picker
          v-model="${businessName}Daterange${AttrName}"
          value-format="YYYY-MM-DD"
          type="daterange"
          range-separator="-"
          start-placeholder="开始日期"
          end-placeholder="结束日期"
        ></el-date-picker>
      </el-form-item>
#end
#end
#end
      <el-form-item>
        <el-button type="primary" icon="Search" @click="${businessName}HandleQuery">搜索</el-button>
        <el-button icon="Refresh" @click="${businessName}ResetQuery">重置</el-button>
      </el-form-item>
    </el-form>

    <el-row :gutter="10" class="mb8">
      <el-col :span="1.5">
        <el-button type="primary" plain icon="Plus" @click="${businessName}HandleAdd" v-hasPermi="['${permissionPrefix}:add']">新增</el-button>
      </el-col>
      <el-col :span="1.5">
        <el-button type="success" plain icon="Edit" :disabled="${businessName}Single" @click="${businessName}HandleUpdate" v-hasPermi="['${permissionPrefix}:edit']">修改</el-button>
      </el-col>
      <el-col :span="1.5">
        <el-button type="danger" plain icon="Delete" :disabled="${businessName}Multiple" @click="${businessName}HandleDelete" v-hasPermi="['${permissionPrefix}:remove']">删除</el-button>
      </el-col>
      <el-col :span="1.5">
        <el-button type="warning" plain icon="Download" @click="${businessName}HandleExport" v-hasPermi="['${permissionPrefix}:export']">导出</el-button>
      </el-col>
      <el-col :span="1.5">
        <el-button type="info" plain icon="Download" @click="${businessName}ImportTemplate" v-hasPermi="['${permissionPrefix}:import']">下载模板</el-button>
      </el-col>
      <el-col :span="1.5">
        <file-upload
          v-model="importRes"
          v-hasPermi="['${permissionPrefix}:import']"
          :limit="1"
          uploadBtnText="导入"
          :fileType="['xlsx']"
          accept=".xlsx"
          :action="'/${moduleName}/${businessName}/importData'"
          :isShowTip="false"
          :isShowFileList="false"
          isImport
        />
      </el-col>
      <right-toolbar v-model:showSearch="${businessName}ShowSearch" @queryTable="${businessName}GetList"></right-toolbar>
    </el-row>

    <el-table
      v-loading="${businessName}Loading"
      :data="${businessName}List"
      :row-class-name="${businessName}RowClassName"
      border
      @row-click="${businessName}HandleRowClick"
      @selection-change="${businessName}HandleSelectionChange"
    >
      <el-table-column type="selection" width="55" align="center" />
#foreach($column in $columns)
#set($javaField=$column.javaField)
#set($parentheseIndex=$column.columnComment.indexOf("（"))
#if($parentheseIndex != -1)
#set($comment=$column.columnComment.substring(0, $parentheseIndex))
#else
#set($comment=$column.columnComment)
#end
#if($column.pk && $column.list)
      <el-table-column width="70" label="${comment}" align="center" prop="${javaField}" />
#elseif($column.list && $column.htmlType == "datetime")
      <el-table-column label="${comment}" align="center" prop="${javaField}" width="180">
        <template #default="scope">
          <span>{{ parseTime(scope.row.${javaField}, '{y}-{m}-{d} {h}:{i}:{s}') }}</span>
        </template>
      </el-table-column>
#elseif($column.list && $column.htmlType == "imageUpload")
      <el-table-column label="${comment}" align="center" prop="${javaField}" width="100">
        <template #default="scope">
          <image-preview :src="scope.row.${javaField}" :width="50" :height="50"/>
        </template>
      </el-table-column>
#elseif($column.list && "" != $column.dictType)
      <el-table-column label="${comment}" align="center" prop="${javaField}">
        <template #default="scope">
#if($column.htmlType == "checkbox")
          <dict-tag :options="${column.dictType}" :value="scope.row.${javaField} ? scope.row.${javaField}.split(',') : []"/>
#else
          <dict-tag :options="${column.dictType}" :value="scope.row.${javaField}"/>
#end
        </template>
      </el-table-column>
#elseif($column.list && "" != $javaField)
      <el-table-column label="${comment}" align="center" prop="${javaField}" show-overflow-tooltip />
#end
#end
      <el-table-column width="150" label="操作" align="center" class-name="small-padding fixed-width">
        <template #default="scope">
          <el-button link type="primary" icon="Edit" @click.stop="${businessName}HandleUpdate(scope.row)" v-hasPermi="['${permissionPrefix}:edit']">修改</el-button>
          <el-button link type="primary" icon="Delete" @click.stop="${businessName}HandleDelete(scope.row)" v-hasPermi="['${permissionPrefix}:remove']">删除</el-button>
        </template>
      </el-table-column>
    </el-table>

    <pagination
      v-show="${businessName}Total>0"
      :total="${businessName}Total"
      v-model:page="${businessName}QueryParams.pageNum"
      v-model:limit="${businessName}QueryParams.pageSize"
      @pagination="${businessName}GetList"
    />
  </div>
</template>

<script setup name="${BusinessName}List">
import { list${BusinessName}, del${BusinessName} } from "@/api/${moduleName}/${businessName}";

const dateRange = ref([]);
const route = useRoute();
const router = useRouter();
const { proxy } = getCurrentInstance();
#if(${dicts} != '')
#set($dictsNoSymbol=$dicts.replace("'", ""))
const { ${dictsNoSymbol} } = proxy.useDict(${dicts});
#end

const ${businessName}PageBase = "/business/${moduleName}/${businessName}";
const ${businessName}ListPath = "/${moduleName}/${businessName}";
const importRes = ref(null);
const ${businessName}List = ref([]);
const ${businessName}Loading = ref(true);
const ${businessName}ShowSearch = ref(true);
const ${businessName}Ids = ref([]);
const ${businessName}Single = ref(true);
const ${businessName}Multiple = ref(true);
const ${businessName}Total = ref(0);
#foreach ($column in $columns)
#if($column.htmlType == "datetime" && $column.queryType == "BETWEEN")
#set($AttrName=$column.javaField.substring(0,1).toUpperCase() + ${column.javaField.substring(1)})
const ${businessName}Daterange${AttrName} = ref([]);
#end
#end

const ${businessName}Data = reactive({
  ${businessName}QueryParams: {
    pageNum: 1,
    pageSize: 10,
#foreach ($column in $columns)
#if($column.query)
    $column.javaField: null#if($foreach.count != $columns.size()),#end
#end
#end
  }
});

const { ${businessName}QueryParams } = toRefs(${businessName}Data);

watch(
  () => importRes.value,
  (val) => {
    if (val && val.code == 200) {
      ${businessName}HandleQuery();
    }
  },
  { deep: true }
);

onMounted(() => {
  ${businessName}HandleQuery();
});

/** 查询${functionName}列表 */
function ${businessName}GetList() {
  ${businessName}Loading.value = true;
#foreach ($column in $columns)
#if($column.htmlType == "datetime" && $column.queryType == "BETWEEN")
  ${businessName}QueryParams.value.params = {};
#break
#end
#end
#foreach ($column in $columns)
#if($column.htmlType == "datetime" && $column.queryType == "BETWEEN")
#set($AttrName=$column.javaField.substring(0,1).toUpperCase() + ${column.javaField.substring(1)})
  if (null != ${businessName}Daterange${AttrName}.value && '' != ${businessName}Daterange${AttrName}.value) {
    ${businessName}QueryParams.value.params["begin${AttrName}"] = ${businessName}Daterange${AttrName}.value[0];
    ${businessName}QueryParams.value.params["end${AttrName}"] = ${businessName}Daterange${AttrName}.value[1];
  }
#end
#end
  list${BusinessName}(proxy.addDateRange(${businessName}QueryParams.value, dateRange.value, 'create_time', true)).then(response => {
    ${businessName}List.value = response.rows;
    ${businessName}Total.value = response.total;
  }).finally(() => {
    ${businessName}Loading.value = false;
  });
}

/** 搜索按钮操作 */
function ${businessName}HandleQuery() {
  ${businessName}QueryParams.value.pageNum = 1;
  ${businessName}GetList();
}

/** 重置按钮操作 */
function ${businessName}ResetQuery() {
  dateRange.value = [];
#foreach ($column in $columns)
#if($column.htmlType == "datetime" && $column.queryType == "BETWEEN")
#set($AttrName=$column.javaField.substring(0,1).toUpperCase() + ${column.javaField.substring(1)})
  ${businessName}Daterange${AttrName}.value = [];
#end
#end
  proxy.resetForm("${businessName}QueryRef");
  ${businessName}HandleQuery();
}

/** 多选框选中数据 */
function ${businessName}HandleSelectionChange(selection) {
  ${businessName}Ids.value = selection.map(item => item.${pkColumn.javaField});
  ${businessName}Single.value = selection.length != 1;
  ${businessName}Multiple.value = !selection.length;
}

/** 新增按钮操作 */
function ${businessName}HandleAdd() {
  router.push(${businessName}PageBase + "/add");
}

/** 修改按钮操作 */
function ${businessName}HandleUpdate(row) {
  const id = row?.${pkColumn.javaField} || ${businessName}Ids.value?.[0];
  if (!id) {
    proxy.#[[$]]#modal.msgWarning("请先选择一条记录");
    return;
  }
  router.push(${businessName}PageBase + "/edit/" + id);
}

/** 删除按钮操作 */
function ${businessName}HandleDelete(row) {
  const ids = row?.${pkColumn.javaField} || ${businessName}Ids.value;
  if (!ids || (Array.isArray(ids) && ids.length === 0)) {
    proxy.#[[$]]#modal.msgWarning("请先选择要删除的记录");
    return;
  }
  proxy.#[[$]]#modal.confirm('是否确认删除编号为"' + ids + '"的数据项？').then(function() {
    return del${BusinessName}(ids);
  }).then(() => {
    ${businessName}GetList();
    proxy.#[[$]]#modal.msgSuccess("删除成功");
  }).catch(() => {});
}

/** 点击行进入详情页 */
function ${businessName}HandleRowClick(row, column) {
  if (!row || !row.${pkColumn.javaField}) return;
  if (column && (column.type === "selection" || column.label === "操作")) return;
  router.push(${businessName}PageBase + "/view/" + row.${pkColumn.javaField});
}

function ${businessName}RowClassName() {
  return "${businessName}-clickable-row";
}

/** 导出按钮操作 */
function ${businessName}HandleExport() {
  proxy.download('${moduleName}/${businessName}/export', {
    ...${businessName}QueryParams.value
  }, `${functionName}_#[[${new Date().getTime()}]]#.xlsx`)
}

/** 下载模板操作 */
function ${businessName}ImportTemplate() {
  proxy.download(
    "${moduleName}/${businessName}/importTemplate",
    {},
    `${functionName}_#[[${new Date().getTime()}]]#.xlsx`
  );
}
</script>

<style lang="scss" scoped>
:deep(.${businessName}-clickable-row) {
  cursor: pointer;
}
</style>
